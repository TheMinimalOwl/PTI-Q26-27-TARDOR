{
  "openapi": "3.1.0",
  "info": {
    "title": "Comparador de precios de supermercados",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "sistema"
        ],
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/chains": {
      "get": {
        "tags": [
          "catálogo"
        ],
        "summary": "Chains",
        "operationId": "chains_chains_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ChainOut"
                  },
                  "type": "array",
                  "title": "Response Chains Chains Get"
                }
              }
            }
          }
        }
      }
    },
    "/products/search": {
      "get": {
        "tags": [
          "catálogo"
        ],
        "summary": "Search Products",
        "description": "Productes de totes les cadenes el nom dels quals conté totes les paraules de `q`,\nordenats per preu unitari (€/kg, €/l…) de menor a major.",
        "operationId": "search_products_products_search_get",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 100,
              "description": "Texto a buscar, p. ej. 'aceite oliva'",
              "title": "Q"
            },
            "description": "Texto a buscar, p. ej. 'aceite oliva'"
          },
          {
            "name": "chain",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filtra por cadena (slug), p. ej. 'mercadona'",
              "title": "Chain"
            },
            "description": "Filtra por cadena (slug), p. ej. 'mercadona'"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 20,
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Offset"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchPage"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/products/{product_id}": {
      "get": {
        "tags": [
          "catálogo"
        ],
        "summary": "Get Product",
        "operationId": "get_product_products__product_id__get",
        "parameters": [
          {
            "name": "product_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Product Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductDetail"
                }
              }
            }
          },
          "404": {
            "description": "Producto no encontrado"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/products/{product_id}/prices": {
      "get": {
        "tags": [
          "precios"
        ],
        "summary": "Get Price History",
        "description": "Evolució del preu d'un producte, del més antic al més recent.",
        "operationId": "get_price_history_products__product_id__prices_get",
        "parameters": [
          {
            "name": "product_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Product Id"
            }
          },
          {
            "name": "from",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Desde (YYYY-MM-DD)",
              "title": "From"
            },
            "description": "Desde (YYYY-MM-DD)"
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Hasta (YYYY-MM-DD)",
              "title": "To"
            },
            "description": "Hasta (YYYY-MM-DD)"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PriceHistory"
                }
              }
            }
          },
          "404": {
            "description": "Producto no encontrado"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChainOut": {
        "properties": {
          "slug": {
            "type": "string",
            "title": "Slug"
          },
          "name": {
            "type": "string",
            "title": "Name"
          }
        },
        "type": "object",
        "required": [
          "slug",
          "name"
        ],
        "title": "ChainOut"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "db": {
            "type": "boolean",
            "title": "Db"
          },
          "redis": {
            "type": "boolean",
            "title": "Redis"
          }
        },
        "type": "object",
        "required": [
          "status",
          "db",
          "redis"
        ],
        "title": "Health"
      },
      "PriceHistory": {
        "properties": {
          "product_id": {
            "type": "integer",
            "title": "Product Id"
          },
          "unit": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unit"
          },
          "points": {
            "items": {
              "$ref": "#/components/schemas/PriceOut"
            },
            "type": "array",
            "title": "Points"
          }
        },
        "type": "object",
        "required": [
          "product_id",
          "unit",
          "points"
        ],
        "title": "PriceHistory"
      },
      "PriceOut": {
        "properties": {
          "observed_on": {
            "type": "string",
            "format": "date",
            "title": "Observed On"
          },
          "store": {
            "type": "string",
            "title": "Store"
          },
          "total": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Total"
          },
          "unit_price": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unit Price"
          },
          "unit_src": {
            "type": "string",
            "title": "Unit Src"
          }
        },
        "type": "object",
        "required": [
          "observed_on",
          "store",
          "total",
          "unit_price",
          "unit_src"
        ],
        "title": "PriceOut"
      },
      "ProductDetail": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "chain": {
            "$ref": "#/components/schemas/ChainOut"
          },
          "category": {
            "type": "string",
            "title": "Category"
          },
          "unit": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unit"
          },
          "url": {
            "type": "string",
            "title": "Url"
          },
          "price": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PriceOut"
              },
              {
                "type": "null"
              }
            ]
          },
          "source_id": {
            "type": "string",
            "title": "Source Id"
          },
          "size": {
            "type": "string",
            "title": "Size"
          },
          "size_format": {
            "type": "string",
            "title": "Size Format"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "chain",
          "category",
          "unit",
          "url",
          "price",
          "source_id",
          "size",
          "size_format",
          "updated_at"
        ],
        "title": "ProductDetail"
      },
      "ProductSummary": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "chain": {
            "$ref": "#/components/schemas/ChainOut"
          },
          "category": {
            "type": "string",
            "title": "Category"
          },
          "unit": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unit"
          },
          "url": {
            "type": "string",
            "title": "Url"
          },
          "price": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PriceOut"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "chain",
          "category",
          "unit",
          "url",
          "price"
        ],
        "title": "ProductSummary"
      },
      "SearchPage": {
        "properties": {
          "query": {
            "type": "string",
            "title": "Query"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "limit": {
            "type": "integer",
            "title": "Limit"
          },
          "offset": {
            "type": "integer",
            "title": "Offset"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/ProductSummary"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "query",
          "total",
          "limit",
          "offset",
          "items"
        ],
        "title": "SearchPage"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
