# Copiar a .env per executar l'API fora de Docker (uvicorn app.main:app --reload)
DATABASE_URL=postgresql+psycopg://pti:pti@localhost:5432/precios
REDIS_URL=redis://localhost:6379/0
NATS_URL=nats://localhost:4222
CACHE_TTL=300
EMBEDDING_DIM=384
# Servei d'embeddings de la IA (VM 2). Buit = no se sincronitzen.
EMBED_URL=
EMBED_API_KEY=
