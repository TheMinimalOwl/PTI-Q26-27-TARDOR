# Entorno Fission con pydantic para la funcion `normalizer`.
#
# La imagen `python` prebuilt de Fission **no** trae pydantic y la funcion lo
# necesita (contrato Pydantic, ver docs/05-pendientes.md). Esta imagen hereda del
# entorno actual y lo instala.
#
# El base por defecto es el que usa el cluster (entorno `python`, Fission 1.27.0,
# version 3, poolsize 3). `deploy.sh` ademas lo detecta y lo pasa como --build-arg:
#   kubectl -n default get environment python -o jsonpath='{.spec.runtime.image}'
ARG FISSION_PY_ENV=ghcr.io/fission/python-env
FROM ${FISSION_PY_ENV}

COPY requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt
