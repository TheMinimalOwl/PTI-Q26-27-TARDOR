[Unit]
# LLM local con Ollama (unidad de USUARIO).
#
# Ollama instalado por usuario (sin sudo): el binario en ~/ollama/bin y los
# runners en ~/ollama/lib/ollama (si se copia solo el binario, el modelo se
# descarga pero la inferencia falla con "llama-server binary not found").
#
#   mkdir -p ~/.config/systemd/user
#   cp deploy/ollama.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now ollama
Description=Ollama (LLM local del prototipo de RAG)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/ollama/bin/ollama serve
Environment=OLLAMA_MODELS=%h/.ollama/models
Environment=OLLAMA_HOST=127.0.0.1:11434
Restart=always
RestartSec=5
TimeoutStartSec=120

[Install]
WantedBy=default.target
